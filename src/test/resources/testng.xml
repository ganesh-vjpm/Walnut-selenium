<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="WalnutAutomationSuite">

    <listeners>
        <listener class-name="com.walnut.automation.listeners.ExtentReportListener"/>
        <listener class-name="com.walnut.automation.listeners.AnnotationTransformer"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="false"/>

    <test name="LoginTest">
        <classes>
            <class name="com.walnut.automation.tests.LoginTest"/>
        </classes>
    </test>

</suite>
